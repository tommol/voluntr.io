{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Voluntrio.Api"
    }
  },
  "ConnectionStrings": {
    "OrganizationsDb": "Host=localhost;Port=5432;Database=voluntrio;Username=postgres;Password=postgres"
  },
  "Nats": {
    "Url": "nats://nats.mnq.nl-ams.scaleway.com:4222",
    "SubjectPrefix": "voluntrio.integration"
  },
  "OutboxProcessing": {
    "MaxRetryAttempts": 3,
    "RetryDelay": "00:01:00",
    "PollInterval": "00:00:02"
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Kinde": {
      "Issuer": "https://voluntrio-dev.eu.kinde.com",
      "Audience": "https://voluntrio-api",
      "ManagementApi": {
        "ClientId": "ea0eacecd2c343b48e187796ed111d79",
        "ClientSecret": "Lz7W5i9wfrsaSJ2Fv7X3ied8KwxmARqsKfpTBXfpa6W1XmSzYU6GO",
        "Audience": "https://voluntrio-dev.eu.kinde.com/api",
        "BaseUrl": "https://voluntrio-dev.eu.kinde.com/api"
      }
    }
  }
}
